# Copy to deploy/.env and fill in. `docker compose -f deploy/docker-compose.yml
# up -d` reads it from the compose file's own directory.

# The bare domain the app is reachable at. Caddy serves the app at DOMAIN
# and the API at api.DOMAIN (deploy/Caddyfile) — point both an A/AAAA
# record at this host before starting caddy, or it can't issue certificates.
DOMAIN=example.com

# Postgres, inside the compose network only (never published to the host).
POSTGRES_USER=digsite
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=digsite

# Signs sessions. Generate with `openssl rand -hex 32`. The server refuses
# to start while this is still the placeholder below (deploy/Dockerfile.server).
AUTH_SECRET=replace-with-a-long-random-secret

# fs (DATA_DIR, a named volume — see docker-compose.yml's `digsite-data`) or
# s3 (any S3-compatible endpoint). Switching after data exists does not
# migrate it — see README.md "Upgrade".
STORAGE=fs

# Only read when STORAGE=s3. The bundled `minio` service (profile `s3`,
# `docker compose --profile s3 up -d`) matches these when S3_ENDPOINT is
# left as http://minio:9000; point at a real bucket instead to skip minio
# entirely (then don't start the `minio` service).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=digsite
S3_ACCESS_KEY=digsite
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_REGION=us-east-1

# Tuning — safe to leave at these defaults; see server/README.md and
# server/src/env.ts for what each one bounds.
INVITATION_EXPIRES_IN=172800
WORKER_CONCURRENCY=4
LADDER_BUDGET_MB=4096
MATERIALISE_BUDGET_MB=2048
COARSE_BUDGET_MB=1024
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
AUTH_RATE_LIMIT_WINDOW=10
AUTH_RATE_LIMIT_MAX=100
RATE_UPLOAD_PER_MIN=120
RATE_TUS_CREATE_PER_MIN=20
RATE_SOCKET_CONNECT_PER_MIN=30
RATE_SCENE_EMIT_PER_SEC=30
UPLOAD_MAX_MB=50
UPLOAD_MAX_PIXELS=100000000
DECODE_TIMEOUT_MS=15000

# Prometheus scrape auth (docker-compose.yml's server.environment) — GET
# /metrics 404s while this is unset.
#METRICS_TOKEN=replace-with-a-long-random-token
