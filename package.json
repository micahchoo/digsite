{
  "name": "digsite",
  "private": true,
  "workspaces": ["shared", "server", "web", "e2e"],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "bun run --filter @digsite/server migrate",
    "seed": "bun run --filter @digsite/server seed",
    "dev": "bun run scripts/dev.ts",
    "test": "bun run --filter '*' test",
    "check": "bun run --filter '*' check && biome check . && bun run scripts/lint-seams.ts",
    "lint:seams": "bun run scripts/lint-seams.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  }
}
