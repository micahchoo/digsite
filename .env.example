DATABASE_URL=postgres://digsite:digsite@127.0.0.1:5440/digsite
AUTH_SECRET=
SERVER_ORIGIN=http://localhost:8800
WEB_ORIGIN=http://localhost:5180
DATA_DIR=./data
LADDER_BUDGET_MB=4096
INVITATION_EXPIRES_IN=172800
WORKER_CONCURRENCY=4
# Bind address, never the origin — 127.0.0.1 by default so a dev server
# isn't reachable off the box. deploy/docker-compose.yml sets 0.0.0.0.
HOST=127.0.0.1
# Set instead of SERVER_ORIGIN behind a reverse proxy (deploy/.env does
# this) — wins verbatim, port and all, and is what Better Auth's baseURL
# (and, through it, cookie Secure) uses. Unset here: local dev has no proxy.
#PUBLIC_ORIGIN=
# auth.ts's session option, seconds.
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# auth.ts's rateLimit option (Better Auth itself only enforces it when
# NODE_ENV=production — see auth.ts's comment).
AUTH_RATE_LIMIT_WINDOW=10
AUTH_RATE_LIMIT_MAX=100
# limits.ts's token buckets.
RATE_UPLOAD_PER_MIN=120
RATE_TUS_CREATE_PER_MIN=20
RATE_SOCKET_CONNECT_PER_MIN=30
RATE_SCENE_EMIT_PER_SEC=30
# boards/validate.ts's upload checks.
UPLOAD_MAX_MB=50
UPLOAD_MAX_PIXELS=100000000
DECODE_TIMEOUT_MS=15000
# GET /metrics 404s unless this is set.
#METRICS_TOKEN=
# fs (default, DATA_DIR above) or s3 (any S3-compatible endpoint, path-style).
STORAGE=fs
# Only read when STORAGE=s3. `bun run infra:up` starts a local minio matching
# these; see docker-compose.yml's `minio`/`minio-init` services.
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=digsite
S3_ACCESS_KEY=digsite
S3_SECRET_KEY=digsite-secret
S3_REGION=us-east-1
